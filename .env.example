# 工学智链运行配置
ENVIRONMENT=development
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///E:/multi-agent-engi-learning-portrait/data/gongxue_v1.db
JWT_SECRET=请替换为至少32位的随机字符串
CORS_ORIGINS=http://localhost:5173

# Docker Compose 使用；本地 SQLite 开发不会读取 DB_PASSWORD
DB_PASSWORD=请替换为数据库强随机密码
GW_PORT=8000
FRONTEND_PORT=5173

# 可选：仅当明确设置强密码时创建治理管理员，不存在默认管理员账号
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=治理管理员
BOOTSTRAP_ADMIN_PASSWORD=

# 多 Agent 执行控制
DEBATE_MAX_ROUNDS=3
NORMAL_SESSION_TIMEOUT_SECONDS=30
DEBATE_SESSION_TIMEOUT_SECONDS=90

# BYOK 与联网增强。平台不需要预置外部密钥；用户可在页面自行配置
LLM_ENABLED=false
BYOK_MASTER_KEY=
TEMPORARY_KEY_TTL_MINUTES=480
ALLOW_PRIVATE_INTEGRATION_HOSTS=false
